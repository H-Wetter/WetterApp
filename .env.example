# Vorlage für die Datei .env (diese Vorlage darf ins Git, die echte .env NIE).
# So geht's: Datei kopieren, in ".env" umbenennen und die Werte eintragen.

# Kostenloser Schlüssel für die Windy Webcams API – anlegen unter https://api.windy.com/keys
# Achtung: Er landet im fertigen JavaScript und ist im Browser sichtbar (kostet aber nichts).
VITE_WINDY_API_KEY=

# Passwort für StatiCrypt (nur für "npm run encrypt" auf deinem PC, mindestens 16 Zeichen)
STATICRYPT_PASSWORD=
